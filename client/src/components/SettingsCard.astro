---
---

<div class="card settings-card">
  <div class="card-header">
    <div class="header-title">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      <h2>Stream Settings</h2>
    </div>
    <div id="settingsLockNotice" class="lock-notice" style="display: none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>Settings Locked During Streaming</span>
    </div>
  </div>

  <div class="settings-grid">
    <div class="form-group">
      <label for="videoSource">
        <span>Video Source</span>
      </label>
      <div class="select-wrapper">
        <select id="videoSource">
          <option value="screen" selected>Screen Capture (getDisplayMedia)</option>
          <option value="synthetic">Bouncing Orb / Test Pattern (Synthetic)</option>
        </select>
        <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <div class="form-group">
      <label for="resolution">
        <span>Resolution</span>
      </label>
      <div class="select-wrapper">
        <select id="resolution">
          <option value="1280x720">720p (1280x720)</option>
          <option value="1920x1080" selected>1080p (1920x1080)</option>
          <option value="2560x1440">2K (2560x1440)</option>
          <option value="3840x2160">4K (3840x2160)</option>
        </select>
        <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <div class="form-group">
      <label for="fps">
        <span>Target Frame Rate</span>
      </label>
      <div class="select-wrapper">
        <select id="fps">
          <option value="30" selected>30 FPS</option>
          <option value="60">60 FPS</option>
        </select>
        <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <div class="form-group">
      <label for="codec">
        <span>Video Codec</span>
      </label>
      <div class="select-wrapper">
        <select id="codec">
          <option value="H265" selected>HEVC / H.265 (Hardware)</option>
          <option value="H264">H.264 (Hardware)</option>
        </select>
        <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <div class="form-group">
      <label for="bitrate">
        <span>Bandwidth / Quality</span>
      </label>
      <div class="select-wrapper">
        <select id="bitrate">
          <option value="auto" selected>Auto (Optimal Quality)</option>
          <option value="3">Low (3 Mbps)</option>
          <option value="8">Balanced (8 Mbps)</option>
          <option value="16">High Quality (16 Mbps)</option>
          <option value="30">Maximum Quality (30 Mbps)</option>
        </select>
        <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 20px 24px;
    margin-bottom: 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .header-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-accent);
  }

  .header-title h2 {
    font-size: 1.05rem;
    font-weight: 600;
    color: #f1f5f9;
    margin: 0;
  }

  .lock-notice {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 4px 10px;
    border-radius: 6px;
    animation: fadeIn 0.25s ease;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .select-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  select {
    width: 100%;
    padding: 10px 36px 10px 12px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: #f8fafc;
    font-size: 0.9rem;
    font-family: inherit;
    appearance: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  select:hover:not(:disabled) {
    border-color: rgba(56, 189, 248, 0.5);
    background: rgba(15, 23, 42, 0.95);
  }

  select:focus:not(:disabled) {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
  }

  select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: rgba(30, 41, 59, 0.5);
    border-color: rgba(51, 65, 85, 0.5);
    color: #94a3b8;
  }

  .select-icon {
    position: absolute;
    right: 12px;
    pointer-events: none;
    color: #64748b;
    transition: color 0.2s ease;
  }

  select:focus + .select-icon {
    color: var(--color-accent);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-3px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
