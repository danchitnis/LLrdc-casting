---
---

<div class="card telemetry-card">
  <div class="card-header">
    <div class="header-title">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
      </svg>
      <h2>Cast status</h2>
    </div>
    <span class="telemetry-hint">Live overview</span>
  </div>

  <div class="telemetry-grid">
    <div class="stat-box">
      <span class="stat-label">Receiver</span>
      <span class="stat-value highlight" id="statEdidName">--</span>
    </div>
    <div class="stat-box">
      <span class="stat-label">Display</span>
      <span class="stat-value highlight" id="statSignal">--</span>
    </div>
    <div class="stat-box stat-box-wide">
      <span class="stat-label">Target output</span>
      <span class="stat-value" id="statEncodedOutput">Not streaming</span>
      <span class="stat-detail" id="statCodec">HEVC / H.265</span>
    </div>
    <div class="stat-box">
      <span class="stat-label">Estimated stream latency</span>
      <span class="stat-value highlight" id="statDevicePing">--</span>
      <span class="stat-detail" id="statLatencyDetail">Available while streaming</span>
    </div>
    <div class="stat-box">
      <span class="stat-label">Encoder</span>
      <span class="stat-value" id="statEncoderHW">Checking...</span>
    </div>
    <div class="stat-box">
      <span class="stat-label">Frames written to transport</span>
      <span class="stat-value" id="statFrameCount">0</span>
    </div>
  </div>
</div>

<style>
  .card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 20px 24px;
    margin-bottom: 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .header-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-accent);
  }

  .header-title h2 {
    font-size: 1.05rem;
    font-weight: 600;
    color: #f1f5f9;
    margin: 0;
  }

  .telemetry-hint {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
  }

  .stat-box {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(51, 65, 85, 0.5);
    border-radius: 8px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .stat-box-wide { grid-column: span 2; }

  .stat-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .stat-value,
  .stat-detail {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
  }

  .stat-value {
    font-size: 0.95rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .stat-detail {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .stat-value.highlight { color: var(--color-accent); }

  @media (max-width: 520px) {
    .stat-box-wide { grid-column: span 1; }
  }
</style>
