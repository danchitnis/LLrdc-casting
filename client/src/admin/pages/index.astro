---
import ManagementCard from '../components/ManagementCard.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>LLRDC Management</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #08111f;
        --card: #111d31;
        --line: #263852;
        --text: #edf5ff;
        --muted: #90a4bd;
        --blue: #45c2ff;
        --green: #35d49a;
        --yellow: #ffc857;
        --red: #ff647c;
      }

      * { box-sizing: border-box; }
      body { margin: 0; padding: 24px; background: radial-gradient(circle at top left, #16294a, var(--bg) 55%); font: 14px system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--text); }
      main { max-width: 1200px; margin: auto; }
      header, .card-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
      header { margin-bottom: 18px; }
      h1 { font-size: 1.35rem; margin: 0; }
      h2 { font-size: 1rem; margin: 0 0 12px; color: var(--blue); }
      .card-heading h2 { margin: 0; }
      .badge { padding: 5px 10px; border: 1px solid var(--line); border-radius: 99px; color: var(--green); font-weight: 700; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
      .card { background: rgba(17, 29, 49, .92); border: 1px solid var(--line); border-radius: 12px; padding: 16px; margin-bottom: 14px; }
      .metric { background: #0b1729; border-radius: 8px; padding: 11px; }
      .label { display: block; color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; }
      .value { display: block; margin-top: 5px; font: 600 1.05rem ui-monospace, monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      button { border-radius: 8px; padding: 10px 15px; font-weight: 800; cursor: pointer; }
      button:disabled { opacity: .45; cursor: not-allowed; }
      input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--blue); }
      .setting-row { display: flex; align-items: center; gap: 10px; font-weight: 700; }
      .setting-help { margin: 10px 0 0; color: var(--muted); }
      .setting-status { min-height: 1.3em; margin: 10px 0 0; }
      .tabs { display: flex; gap: 8px; margin-bottom: 16px; overflow-x: auto; padding-bottom: 2px; }
      .tab { background: #1b3150; border: 1px solid #355477; color: var(--text); }
      .tab.active { background: var(--blue); color: #06111d; }
      .tab:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
      .tab-panel[hidden] { display: none; }
      .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
      .field { display: grid; gap: 5px; color: var(--muted); font-size: .8rem; }
      .field input, .field select { width: 100%; border: 1px solid var(--line); border-radius: 7px; padding: 9px; background: #0b1729; color: var(--text); }
      .field input:read-only { opacity: .7; }
      .settings-actions { display: flex; gap: 10px; align-items: center; margin-top: 14px; }
      .danger { background: var(--red); border: 0; color: #19050a; }
      .secondary { background: #1b3150; border: 1px solid #355477; color: var(--text); }
      table { width: 100%; border-collapse: collapse; font-size: .84rem; }
      th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { color: var(--muted); font-size: .7rem; text-transform: uppercase; }
      canvas { width: 100%; height: 180px; background: #0b1729; border-radius: 8px; }
      .chart-stack { display: grid; gap: 14px; margin-top: 14px; }
      .chart-panel { display: grid; gap: 7px; }
      .chart-panel h3 { margin: 0; color: var(--muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; }
      .chart-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 14px; }
      .chart-heading h3 { margin: 0; }
      .series-controls { display: flex; flex-wrap: wrap; gap: 6px; }
      .series-toggle { display: inline-flex; align-items: center; gap: 6px; padding: 6px 9px; border: 1px solid #355477; background: #0b1729; color: var(--muted); font-size: .72rem; }
      .series-toggle[aria-pressed="true"] { border-color: var(--series-color); color: var(--text); box-shadow: inset 0 0 0 1px var(--series-color); }
      .series-toggle:disabled { opacity: 1; cursor: default; }
      .series-swatch { width: 9px; height: 9px; flex: 0 0 auto; border-radius: 50%; background: var(--series-color); }
      .muted { color: var(--muted); }
      .table-scroll { overflow: auto; }
      #metrics { margin-top: 12px; }
      .log-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
      .log-toolbar select, .log-toolbar input { min-height: 38px; border: 1px solid #355477; border-radius: 8px; padding: 7px 10px; background: #0b1729; color: var(--text); }
      .log-toolbar input { min-width: min(260px, 65vw); }
      .log-summary { display: flex; justify-content: space-between; gap: 12px; margin: 12px 0 8px; color: var(--muted); font-size: .78rem; }
      .log-viewer { max-height: min(68vh, 760px); min-height: 280px; overflow-y: auto; overscroll-behavior: contain; scrollbar-color: #3d628b #0b1729; border: 1px solid var(--line); border-radius: 10px; background: #081321; }
      .log-viewer.compact { min-height: 140px; max-height: 320px; }
      .log-list { list-style: none; padding: 0; margin: 0; }
      .log-entry { position: relative; display: grid; grid-template-columns: minmax(150px, 205px) minmax(0, 1fr); gap: 8px 16px; padding: 11px 14px 11px 18px; border-bottom: 1px solid rgba(38, 56, 82, .72); }
      .log-entry::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--blue); }
      .log-entry:hover { background: rgba(69, 194, 255, .055); }
      .log-entry.log-error { background: rgba(255, 100, 124, .07); }
      .log-entry.log-error::before { background: var(--red); }
      .log-entry.log-warn::before { background: var(--yellow); }
      .log-entry.log-info::before { background: var(--green); }
      .log-meta { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 6px; color: var(--muted); font: .72rem ui-monospace, monospace; }
      .log-severity, .log-category, .log-generation { display: inline-flex; align-items: center; border-radius: 99px; padding: 2px 7px; border: 1px solid var(--line); }
      .log-severity { color: var(--green); font-weight: 900; }
      .log-error .log-severity { color: var(--red); border-color: rgba(255, 100, 124, .45); }
      .log-warn .log-severity { color: var(--yellow); border-color: rgba(255, 200, 87, .45); }
      .log-category { color: var(--blue); }
      .log-message { margin: 0; color: #d9e7f7; font: .79rem/1.55 ui-monospace, "SFMono-Regular", Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
      .log-empty { display: grid; min-height: 160px; place-items: center; padding: 24px; color: var(--muted); text-align: center; }

      @media (max-width: 560px) {
        body { padding: 14px; }
        .card-heading { align-items: flex-start; flex-direction: column; }
        .log-entry { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>LLRDC Receiver Management</h1>
        <span id="state" class="badge">CONNECTING</span>
      </header>

      <nav class="tabs" role="tablist" aria-label="Management sections">
        <button class="tab active" id="overviewTabButton" type="button" role="tab" aria-controls="overviewTab" aria-selected="true">Overview</button>
        <button class="tab" id="logsTabButton" type="button" role="tab" aria-controls="logsTab" aria-selected="false" tabindex="-1">Logs</button>
        <button class="tab" id="settingsTabButton" type="button" role="tab" aria-controls="settingsTab" aria-selected="false" tabindex="-1">Settings</button>
      </nav>

      <div id="overviewTab" class="tab-panel" role="tabpanel" aria-labelledby="overviewTabButton">
      <ManagementCard title="Live stream">
        <div slot="actions">
          <button id="resetChart" class="secondary" type="button">Reset plot</button>
          <button id="stop" class="danger" type="button" disabled>Stop sharing</button>
        </div>
        <div id="metrics" class="grid"></div>
        <div class="chart-stack">
          <section class="chart-panel" aria-labelledby="bandwidthChartTitle">
            <h3 id="bandwidthChartTitle">Encoded payload throughput</h3>
            <canvas id="chart" width="1000" height="300" aria-label="Measured encoded bitrate over time"></canvas>
          </section>
          <section class="chart-panel" aria-labelledby="latencyChartTitle">
            <div class="chart-heading">
              <h3 id="latencyChartTitle">Estimated stream latency</h3>
              <div id="latencySeriesControls" class="series-controls" role="group" aria-label="Latency graph series">
                <button class="series-toggle" type="button" data-latency-series="total" aria-pressed="true" style="--series-color: #ffc857"><span class="series-swatch" aria-hidden="true"></span>Total</button>
                <button class="series-toggle" type="button" data-latency-series="encode" aria-pressed="false" style="--series-color: #45c2ff"><span class="series-swatch" aria-hidden="true"></span>Encoding</button>
                <button class="series-toggle" type="button" data-latency-series="transport" aria-pressed="false" style="--series-color: #35d49a"><span class="series-swatch" aria-hidden="true"></span>Transport/queue</button>
                <button class="series-toggle" type="button" data-latency-series="decode" aria-pressed="false" style="--series-color: #ff7eb6"><span class="series-swatch" aria-hidden="true"></span>Decode/display</button>
              </div>
            </div>
            <canvas id="latencyChart" width="1000" height="300" aria-label="Estimated stream latency over time"></canvas>
          </section>
        </div>
        <p id="sender" class="muted">No active sender</p>
      </ManagementCard>

      <ManagementCard title="Connected devices">
        <div class="table-scroll">
          <table>
            <thead><tr><th>Device</th><th>Client IP</th><th>Platform</th><th>State</th><th>Last seen</th></tr></thead>
            <tbody id="connections"></tbody>
          </table>
        </div>
      </ManagementCard>

      <ManagementCard title="Sharing history">
        <div class="table-scroll">
          <table>
            <thead><tr><th>Session</th><th>Sender</th><th>Stream</th><th>Duration</th><th>Payload bytes</th><th>End reason</th></tr></thead>
            <tbody id="history"></tbody>
          </table>
        </div>
      </ManagementCard>

      <ManagementCard title="Watchdog">
        <div slot="actions"><button id="restartReceiver" class="danger" type="button">Restart receiver</button></div>
        <div id="watchdog" class="grid"></div>
        <p id="watchdogStatus" class="setting-status" role="status" aria-live="polite"></p>
      </ManagementCard>

      <ManagementCard title="Receiver health">
        <div id="health" class="grid"></div>
      </ManagementCard>
      </div>

      <div id="logsTab" class="tab-panel" role="tabpanel" aria-labelledby="logsTabButton" hidden>
      <ManagementCard title="Operational logs">
        <div slot="actions">
          <button id="downloadLogs" class="secondary" type="button">Download diagnostic ZIP</button>
        </div>
        <div class="log-toolbar" aria-label="Operational log filters">
          <select id="logSeverity" aria-label="Log severity"><option value="all">All severity</option><option value="error">Errors</option><option value="warn">Warnings</option><option value="info">Information</option></select>
          <select id="logCategory" aria-label="Log category"><option value="all">All categories</option></select>
          <input id="logSearch" type="search" placeholder="Search messages" aria-label="Search operational logs" />
          <button id="jumpLatest" class="secondary" type="button">Jump to latest</button>
        </div>
        <div class="log-summary"><span id="logCount">Loading operational events…</span><span>Newest events appear at the bottom</span></div>
        <div id="operationalLogs" class="log-viewer" role="log" aria-label="Operational event journal" tabindex="0"><div class="log-empty">Loading operational events…</div></div>
      </ManagementCard>

      <ManagementCard title="Live receiver events">
        <p class="setting-help">Recent in-memory receiver events for the current generation.</p>
        <div id="events" class="log-viewer compact" role="log" aria-label="Live receiver events" tabindex="0"><div class="log-empty">No receiver events</div></div>
      </ManagementCard>
      </div>

      <div id="settingsTab" class="tab-panel" role="tabpanel" aria-labelledby="settingsTabButton" hidden>
      <ManagementCard title="Display">
        <div class="form-grid">
          <label class="field">DRM connector ID<input id="settingDrmConnector" /></label>
          <label class="field">DRM plane ID<input id="settingDrmPlane" /></label>
          <label class="field">Idle dashboard<select id="settingIdleDashboard"><option value="true">Enabled</option><option value="false">Disabled</option></select></label>
          <label class="field">Dashboard mode<select id="settingDashboardMode"><option value="raw">Raw</option><option value="hevc">HEVC</option></select></label>
        </div>
      </ManagementCard>
      <ManagementCard title="Receiver ports">
        <div class="form-grid">
          <label class="field">Video UDP port<input id="settingPort" type="number" min="1" max="65535" /></label>
          <label class="field">WebTransport port<input id="settingWebtransportPort" type="number" min="1" max="65535" /></label>
          <label class="field">HTTP/UI port<input id="settingHttpPort" type="number" min="1" max="65535" /></label>
        </div>
      </ManagementCard>
      <ManagementCard title="Buffering and timeouts">
        <div class="form-grid">
          <label class="field">UDP buffer (MB)<input id="settingUdpBuffer" type="number" min="1" /></label>
          <label class="field">Idle timeout (seconds)<input id="settingIdleTimeout" type="number" min="1" /></label>
          <label class="field">Sender liveness timeout (seconds)<input id="settingLivenessTimeout" type="number" min="1" /></label>
          <label class="field">Pairing-code TTL (seconds)<input id="settingPairingTtl" type="number" min="1" /></label>
        </div>
      </ManagementCard>
      <ManagementCard title="Deployment-managed settings">
        <div id="deploymentSettings" class="grid"></div>
        <p class="setting-help">These values come from the local repository and deployment provisioning and cannot be changed here.</p>
      </ManagementCard>
      <ManagementCard title="Pairing security">
        <div class="setting-row">
          <input id="localPairingRequired" type="checkbox" aria-describedby="pairingSecurityHelp" />
          <label for="localPairingRequired">Require a security code for direct LAN clients</label>
        </div>
        <p id="pairingSecuritySource" class="setting-help"></p>
        <p id="pairingSecurityHelp" class="setting-help">Disabling this allows any client that can reach the receiver on the network to connect without a code. Applying a change restarts the receiver and interrupts active sharing.</p>
      </ManagementCard>
      <ManagementCard title="Cloud discovery">
        <div class="setting-row">
          <input id="cloudEnabled" type="checkbox" aria-describedby="cloudHelp" />
          <label for="cloudEnabled">Enable Cloudflare discovery</label>
        </div>
        <p id="cloudHelp" class="setting-help">Cloudflare carries pairing discovery only; media remains on the receiver LAN. Use Apply settings below to save changes; the receiver restarts and active sharing is interrupted.</p>
        <p id="cloudConfig" class="setting-help"></p>
      </ManagementCard>
      <div class="settings-actions"><button id="saveSettings" class="secondary" type="button" disabled>Apply settings</button><p id="settingsStatus" class="setting-status" role="status" aria-live="polite"></p></div>
      </div>
    </main>

    <script>
      import '../lib/dashboard';
    </script>
  </body>
</html>
