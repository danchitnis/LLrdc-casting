---
import ManagementCard from '../components/ManagementCard.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>LLRDC Management</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #08111f;
        --card: #111d31;
        --line: #263852;
        --text: #edf5ff;
        --muted: #90a4bd;
        --blue: #45c2ff;
        --green: #35d49a;
        --red: #ff647c;
      }

      * { box-sizing: border-box; }
      body { margin: 0; padding: 24px; background: radial-gradient(circle at top left, #16294a, var(--bg) 55%); font: 14px system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--text); }
      main { max-width: 1200px; margin: auto; }
      header, .card-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
      header { margin-bottom: 18px; }
      h1 { font-size: 1.35rem; margin: 0; }
      h2 { font-size: 1rem; margin: 0 0 12px; color: var(--blue); }
      .card-heading h2 { margin: 0; }
      .badge { padding: 5px 10px; border: 1px solid var(--line); border-radius: 99px; color: var(--green); font-weight: 700; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
      .card { background: rgba(17, 29, 49, .92); border: 1px solid var(--line); border-radius: 12px; padding: 16px; margin-bottom: 14px; }
      .metric { background: #0b1729; border-radius: 8px; padding: 11px; }
      .label { display: block; color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; }
      .value { display: block; margin-top: 5px; font: 600 1.05rem ui-monospace, monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      button { border-radius: 8px; padding: 10px 15px; font-weight: 800; cursor: pointer; }
      button:disabled { opacity: .45; cursor: not-allowed; }
      input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--blue); }
      .setting-row { display: flex; align-items: center; gap: 10px; font-weight: 700; }
      .setting-help { margin: 10px 0 0; color: var(--muted); }
      .setting-status { min-height: 1.3em; margin: 10px 0 0; }
      .tabs { display: flex; gap: 8px; margin-bottom: 16px; }
      .tab { background: #1b3150; border: 1px solid #355477; color: var(--text); }
      .tab.active { background: var(--blue); color: #06111d; }
      .tab-panel[hidden] { display: none; }
      .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
      .field { display: grid; gap: 5px; color: var(--muted); font-size: .8rem; }
      .field input, .field select { width: 100%; border: 1px solid var(--line); border-radius: 7px; padding: 9px; background: #0b1729; color: var(--text); }
      .field input:read-only { opacity: .7; }
      .settings-actions { display: flex; gap: 10px; align-items: center; margin-top: 14px; }
      .danger { background: var(--red); border: 0; color: #19050a; }
      .secondary { background: #1b3150; border: 1px solid #355477; color: var(--text); }
      table { width: 100%; border-collapse: collapse; font-size: .84rem; }
      th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { color: var(--muted); font-size: .7rem; text-transform: uppercase; }
      pre { max-height: 210px; overflow: auto; margin: 0; color: #b9c8dc; font-size: .75rem; white-space: pre-wrap; }
      canvas { width: 100%; height: 180px; background: #0b1729; border-radius: 8px; }
      .muted { color: var(--muted); }
      .table-scroll { overflow: auto; }
      #metrics { margin-top: 12px; }

      @media (max-width: 560px) {
        body { padding: 14px; }
        .card-heading { align-items: flex-start; flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>LLRDC Receiver Management</h1>
        <span id="state" class="badge">CONNECTING</span>
      </header>

      <nav class="tabs" aria-label="Management sections">
        <button class="tab active" id="overviewTabButton" type="button" aria-controls="overviewTab" aria-selected="true">Overview</button>
        <button class="tab" id="settingsTabButton" type="button" aria-controls="settingsTab" aria-selected="false">Settings</button>
      </nav>

      <div id="overviewTab" class="tab-panel">
      <ManagementCard title="Live stream">
        <div slot="actions">
          <button id="resetChart" class="secondary" type="button">Reset plot</button>
          <button id="stop" class="danger" type="button" disabled>Stop sharing</button>
        </div>
        <div id="metrics" class="grid"></div>
        <canvas id="chart" width="1000" height="300" aria-label="Measured encoded bitrate over time"></canvas>
        <p id="sender" class="muted">No active sender</p>
      </ManagementCard>

      <ManagementCard title="Connected devices">
        <div class="table-scroll">
          <table>
            <thead><tr><th>Device</th><th>Client IP</th><th>Platform</th><th>State</th><th>Last seen</th></tr></thead>
            <tbody id="connections"></tbody>
          </table>
        </div>
      </ManagementCard>

      <ManagementCard title="Sharing history">
        <div class="table-scroll">
          <table>
            <thead><tr><th>Session</th><th>Sender</th><th>Stream</th><th>Duration</th><th>Bytes</th><th>End reason</th></tr></thead>
            <tbody id="history"></tbody>
          </table>
        </div>
      </ManagementCard>

      <ManagementCard title="Receiver health &amp; events">
        <div id="health" class="grid"></div>
        <pre id="events"></pre>
      </ManagementCard>
      </div>

      <div id="settingsTab" class="tab-panel" hidden>
      <ManagementCard title="Display">
        <div class="form-grid">
          <label class="field">DRM connector ID<input id="settingDrmConnector" /></label>
          <label class="field">DRM plane ID<input id="settingDrmPlane" /></label>
          <label class="field">Idle dashboard<select id="settingIdleDashboard"><option value="true">Enabled</option><option value="false">Disabled</option></select></label>
          <label class="field">Dashboard mode<select id="settingDashboardMode"><option value="raw">Raw</option><option value="hevc">HEVC</option></select></label>
        </div>
      </ManagementCard>
      <ManagementCard title="Receiver ports">
        <div class="form-grid">
          <label class="field">Video UDP port<input id="settingPort" type="number" min="1" max="65535" /></label>
          <label class="field">WebTransport port<input id="settingWebtransportPort" type="number" min="1" max="65535" /></label>
          <label class="field">HTTP/UI port<input id="settingHttpPort" type="number" min="1" max="65535" /></label>
        </div>
      </ManagementCard>
      <ManagementCard title="Buffering and timeouts">
        <div class="form-grid">
          <label class="field">UDP buffer (MB)<input id="settingUdpBuffer" type="number" min="1" /></label>
          <label class="field">Idle timeout (seconds)<input id="settingIdleTimeout" type="number" min="1" /></label>
          <label class="field">Sender liveness timeout (seconds)<input id="settingLivenessTimeout" type="number" min="1" /></label>
          <label class="field">Pairing-code TTL (seconds)<input id="settingPairingTtl" type="number" min="1" /></label>
        </div>
      </ManagementCard>
      <ManagementCard title="Deployment-managed settings">
        <div id="deploymentSettings" class="grid"></div>
        <p class="setting-help">These values come from the local repository and deployment provisioning and cannot be changed here.</p>
      </ManagementCard>
      <ManagementCard title="Pairing security">
        <div class="setting-row">
          <input id="localPairingRequired" type="checkbox" aria-describedby="pairingSecurityHelp" />
          <label for="localPairingRequired">Require a security code for direct LAN clients</label>
        </div>
        <p id="pairingSecuritySource" class="setting-help"></p>
        <p id="pairingSecurityHelp" class="setting-help">Disabling this allows any client that can reach the receiver on the network to connect without a code. Applying a change restarts the receiver and interrupts active sharing.</p>
      </ManagementCard>
      <ManagementCard title="Cloud discovery">
        <div class="setting-row">
          <input id="cloudEnabled" type="checkbox" aria-describedby="cloudHelp" />
          <label for="cloudEnabled">Enable Cloudflare discovery</label>
        </div>
        <p id="cloudHelp" class="setting-help">Cloudflare carries pairing discovery only; media remains on the receiver LAN. Use Apply settings below to save changes; the receiver restarts and active sharing is interrupted.</p>
        <p id="cloudConfig" class="setting-help"></p>
      </ManagementCard>
      <div class="settings-actions"><button id="saveSettings" class="secondary" type="button" disabled>Apply settings</button><p id="settingsStatus" class="setting-status" role="status" aria-live="polite"></p></div>
      </div>
    </main>

    <script>
      import '../lib/dashboard';
    </script>
  </body>
</html>
