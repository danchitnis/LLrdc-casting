---
import Header from '../components/Header.astro';
import SettingsCard from '../components/SettingsCard.astro';
import TelemetryCard from '../components/TelemetryCard.astro';
import LogConsole from '../components/LogConsole.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LLrdc Casting | Ultra Low Latency Hardware Video Streamer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --color-bg: #0b0f17;
      --color-card: #131b2e;
      --color-border: #23304a;
      --color-accent: #38bdf8;
      --color-accent-hover: #0284c7;
      --color-success: #10b981;
      --color-danger: #ef4444;
      --color-danger-hover: #dc2626;
      --color-text: #f1f5f9;
      --color-text-muted: #94a3b8;
      --font-main: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-main);
      background-color: var(--color-bg);
      background-image: 
        radial-gradient(at 0% 0%, rgba(56, 189, 248, 0.07) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(99, 102, 241, 0.07) 0px, transparent 50%);
      background-attachment: fixed;
      color: var(--color-text);
      margin: 0;
      padding: 32px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }

    .main-container {
      width: 100%;
      max-width: 860px;
    }

    .action-container {
      margin-bottom: 24px;
    }

    .btn-primary {
      width: 100%;
      padding: 16px 24px;
      background: linear-gradient(135deg, #0284c7, #2563eb);
      color: #ffffff;
      border: 1px solid rgba(56, 189, 248, 0.4);
      border-radius: 12px;
      font-size: 1.05rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-primary:hover:not(:disabled) {
      background: linear-gradient(135deg, #0369a1, #1d4ed8);
      box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
      transform: translateY(-1px);
    }

    .btn-primary:active:not(:disabled) {
      transform: translateY(1px);
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }

    .btn-primary.stop {
      background: linear-gradient(135deg, #dc2626, #b91c1c);
      border-color: rgba(239, 68, 68, 0.4);
      box-shadow: 0 4px 16px rgba(220, 38, 38, 0.35);
    }

    .btn-primary.stop:hover:not(:disabled) {
      background: linear-gradient(135deg, #b91c1c, #991b1b);
      box-shadow: 0 6px 20px rgba(220, 38, 38, 0.5);
    }

    .btn-primary.stop:disabled {
      background: linear-gradient(135deg, #7f1d1d, #991b1b);
      border-color: rgba(239, 68, 68, 0.4);
      color: #fca5a5;
      cursor: not-allowed;
      box-shadow: 0 4px 16px rgba(220, 38, 38, 0.2);
      opacity: 0.85;
    }

    .btn-primary:disabled {
      background: #1e293b;
      border-color: #334155;
      color: #64748b;
      cursor: not-allowed;
      box-shadow: none;
      transform: none;
    }
  </style>
</head>
<body>

<div class="main-container">
  <Header />

  <SettingsCard />

  <div class="action-container">
    <button id="toggleBtn" class="btn-primary" onclick="toggleScreenShare()">
      <svg id="toggleIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
      </svg>
      <span id="toggleText">Start Screen Sharing</span>
    </button>
  </div>

  <TelemetryCard />

  <LogConsole />
</div>

<script is:inline>
let transport = null;
let writer = null;
let uniStreamWriter = null;
let mediaStream = null;
let videoEncoder = null;
let isStreaming = false;
let isRemoteStreaming = false;
let seqNum = 0;
let lastKeyFrameTime = 0;
let autoCertHash = null;
let controlWs = null;

let cachedVps = null;
let cachedSps = null;
let cachedPps = null;

function setSettingsDisabled(disabled) {
  const fields = ['videoSource', 'resolution', 'fps', 'codec', 'bitrate'];
  fields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.disabled = disabled;
    }
  });

  const lockNotice = document.getElementById('settingsLockNotice');
  if (lockNotice) {
    lockNotice.style.display = disabled ? 'inline-flex' : 'none';
  }
}

function clearLogs() {
  const logDiv = document.getElementById('log');
  if (logDiv) logDiv.textContent = '';
}

function log(msg, isError = false) {
  const logDiv = document.getElementById('log');
  if (!logDiv) return;
  const timestamp = new Date().toISOString().split('T')[1].slice(0, 8);
  const line = `[${timestamp}] ${msg}\n`;
  logDiv.textContent += line;
  logDiv.scrollTop = logDiv.scrollHeight;
  if (isError) console.error(msg);
  else console.log(msg);
}

function updateStatus(state, label) {
  const badge = document.getElementById('statusBadge');
  const dot = document.getElementById('statusDot');
  if (badge) {
    badge.className = `status-badge ${state}`;
    badge.textContent = label;
  }
  if (dot) {
    dot.className = `status-indicator-dot ${state}`;
  }
}

function parseCertHash(input) {
  if (!input || !input.trim()) return null;
  const str = input.trim();
  
  if (str.startsWith('[')) {
    try {
      const arr = JSON.parse(str);
      return new Uint8Array(arr);
    } catch (e) {}
  }
  
  const cleanHex = str.replace(/[^0-9a-fA-F]/g, '');
  if (cleanHex.length === 64) {
    const bytes = new Uint8Array(32);
    for (let i = 0; i < 32; i++) {
      bytes[i] = parseInt(cleanHex.substr(i * 2, 2), 16);
    }
    return bytes;
  }
  return null;
}

function parseDecoderDescription(description, codec) {
  if (!description) return;
  try {
    const buffer = description.buffer ? description.buffer : description;
    const byteOffset = description.byteOffset || 0;
    const byteLength = description.byteLength || description.size || 0;
    if (byteLength < 7) return;
    const view = new DataView(buffer, byteOffset, byteLength);

    if (codec === 'H265') {
      if (byteLength < 23) return;
      const numOfArrays = view.getUint8(22);
      let offset = 23;

      for (let i = 0; i < numOfArrays; i++) {
        if (offset + 3 > byteLength) break;
        const nalType = view.getUint8(offset) & 0x3f;
        const numNalus = view.getUint16(offset + 1, false);
        offset += 3;

        for (let j = 0; j < numNalus; j++) {
          if (offset + 2 > byteLength) break;
          const nalLen = view.getUint16(offset, false);
          offset += 2;
          if (offset + nalLen > byteLength) break;

          const nalData = new Uint8Array(buffer, byteOffset + offset, nalLen);
          if (nalType === 32) cachedVps = nalData;
          if (nalType === 33) cachedSps = nalData;
          if (nalType === 34) cachedPps = nalData;
          offset += nalLen;
        }
      }
      log(`[HEADER PARSED] HEVC VPS=${!!cachedVps} (${cachedVps?.length}B) SPS=${!!cachedSps} (${cachedSps?.length}B) PPS=${!!cachedPps} (${cachedPps?.length}B)`);
    } else {
      const numOfSps = view.getUint8(5) & 0x1f;
      let offset = 6;
      for (let i = 0; i < numOfSps; i++) {
        if (offset + 2 > byteLength) break;
        const spsLen = view.getUint16(offset, false);
        offset += 2;
        if (offset + spsLen > byteLength) break;
        cachedSps = new Uint8Array(buffer, byteOffset + offset, spsLen);
        offset += spsLen;
      }
      if (offset + 1 > byteLength) return;
      const numOfPps = view.getUint8(offset);
      offset += 1;
      for (let i = 0; i < numOfPps; i++) {
        if (offset + 2 > byteLength) break;
        const ppsLen = view.getUint16(offset, false);
        offset += 2;
        if (offset + ppsLen > byteLength) break;
        cachedPps = new Uint8Array(buffer, byteOffset + offset, ppsLen);
        offset += ppsLen;
      }
      log(`[HEADER PARSED] H264 SPS=${!!cachedSps} (${cachedSps?.length}B) PPS=${!!cachedPps} (${cachedPps?.length}B)`);
    }
  } catch (err) {
    log(`[HEADER PARSER ERROR] ${err.message}`, true);
  }
}

function convertToAnnexB(chunk, metadata, codec) {
  const chunkBuffer = new Uint8Array(chunk.byteLength);
  chunk.copyTo(chunkBuffer);
  
  if (metadata && metadata.decoderConfig && metadata.decoderConfig.description) {
    parseDecoderDescription(metadata.decoderConfig.description, codec);
  }

  const rawNalTypes = [];
  const view = new DataView(chunkBuffer.buffer, chunkBuffer.byteOffset, chunkBuffer.byteLength);
  let scanOffset = 0;
  while (scanOffset + 4 <= chunkBuffer.length) {
    const nalLen = view.getUint32(scanOffset, false);
    scanOffset += 4;
    if (nalLen === 0 || scanOffset + nalLen > chunkBuffer.length) break;
    const headerByte = chunkBuffer[scanOffset];
    const type = codec === 'H265' ? ((headerByte >> 1) & 0x3f) : (headerByte & 0x1f);
    rawNalTypes.push(type);
    scanOffset += nalLen;
  }

  const isKey = (chunk.type === 'key');
  if (isKey || seqNum === 1) {
    const toHex = arr => arr ? Array.from(arr).map(b => b.toString(16).padStart(2,'0')).join('') : 'NULL';
    log(`[KEYFRAME PREPEND HEX] seq=${seqNum} VPS=${toHex(cachedVps)} SPS=${toHex(cachedSps)} PPS=${toHex(cachedPps)}`);
  }
  const startCode = new Uint8Array([0x00, 0x00, 0x00, 0x01]);
  const nalParts = [];

  if (codec === 'H265') {
    nalParts.push(new Uint8Array([0x00, 0x00, 0x00, 0x01, 0x46, 0x01, 0x50]));
  } else {
    nalParts.push(new Uint8Array([0x00, 0x00, 0x00, 0x01, 0x09, 0xf0]));
  }

  if (isKey || seqNum === 1) {
    if (codec === 'H265') {
      if (cachedVps) { nalParts.push(startCode); nalParts.push(cachedVps); }
      if (cachedSps) { nalParts.push(startCode); nalParts.push(cachedSps); }
      if (cachedPps) { nalParts.push(startCode); nalParts.push(cachedPps); }
    } else {
      if (cachedSps) { nalParts.push(startCode); nalParts.push(cachedSps); }
      if (cachedPps) { nalParts.push(startCode); nalParts.push(cachedPps); }
    }
  }

  let offset = 0;
  while (offset + 4 <= chunkBuffer.length) {
    const nalLen = view.getUint32(offset, false);
    offset += 4;
    if (nalLen === 0 || offset + nalLen > chunkBuffer.length) {
      if (chunkBuffer[0] === 0 && chunkBuffer[1] === 0 && (chunkBuffer[2] === 1 || (chunkBuffer[2] === 0 && chunkBuffer[3] === 1))) {
        nalParts.push(chunkBuffer);
      } else {
        nalParts.push(startCode);
        nalParts.push(chunkBuffer.subarray(offset - 4));
      }
      break;
    }
    nalParts.push(startCode);
    nalParts.push(chunkBuffer.subarray(offset, offset + nalLen));
    offset += nalLen;
  }

  let totalLen = 0;
  for (const part of nalParts) totalLen += part.length;

  const result = new Uint8Array(totalLen);
  let pos = 0;
  for (const part of nalParts) {
    result.set(part, pos);
    pos += part.length;
  }
  return result;
}

async function sendAccessUnit(accessUnit, seq, width, height, codec) {
  const tag = codec === 'H265' ? 'H265' : 'H264';

  if (!uniStreamWriter && transport) {
    const uniStream = await transport.createUnidirectionalStream();
    uniStreamWriter = uniStream.getWriter();
  }
  if (!uniStreamWriter) return;

  const packetLen = 16 + accessUnit.length;
  const totalPayloadBytes = 4 + packetLen;
  const combinedBuf = new Uint8Array(totalPayloadBytes);
  const view = new DataView(combinedBuf.buffer);

  view.setUint32(0, packetLen, false);

  for (let i = 0; i < 4; i++) combinedBuf[4 + i] = tag.charCodeAt(i);
  view.setUint32(8, seq, false);
  view.setUint16(12, 0, false);
  view.setUint16(14, 1, false);
  view.setUint16(16, width, false);
  view.setUint16(18, height, false);

  combinedBuf.set(accessUnit, 20);

  await uniStreamWriter.write(combinedBuf);
}

function createSyntheticScreenStream(width, height, fps) {
  let canvas = document.getElementById('screenCanvas');
  if (!canvas) {
    canvas = document.createElement('canvas');
    canvas.id = 'screenCanvas';
    canvas.style.display = 'none';
    document.body.appendChild(canvas);
  }
  canvas.width = width;
  canvas.height = height;
  const ctx = canvas.getContext('2d');

  let frame = 0;
  const intervalMs = 1000 / fps;
  const animInterval = setInterval(() => {
    if (!isStreaming) {
      clearInterval(animInterval);
      return;
    }
    frame++;
    ctx.fillStyle = '#0f172a';
    ctx.fillRect(0, 0, width, height);

    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 2;
    for (let x = 0; x < width; x += 100) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
    }
    for (let y = 0; y < height; y += 100) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
    }

    const time = frame / fps;
    const x = (width / 2) + Math.cos(time * 2) * (width / 3);
    const y = (height / 2) + Math.sin(time * 3) * (height / 3);

    const grad = ctx.createRadialGradient(x, y, 10, x, y, 120);
    grad.addColorStop(0, '#38bdf8');
    grad.addColorStop(1, 'rgba(56, 189, 248, 0)');
    ctx.fillStyle = grad;
    ctx.beginPath(); ctx.arc(x, y, 120, 0, Math.PI * 2); ctx.fill();

    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 48px monospace';
    ctx.fillText(`LLrdc Casting HARDWARE HEVC STREAM`, 100, 120);
    ctx.font = '36px monospace';
    ctx.fillText(`Resolution: ${width}x${height} @ ${fps} FPS`, 100, 180);
    ctx.fillText(`Frame #${frame} | Time: ${time.toFixed(2)}s`, 100, 240);
  }, intervalMs);

  return canvas.captureStream(fps);
}

function updateCodecAndResolutionGuardrails() {
  const codecSelect = document.getElementById('codec');
  const resSelect = document.getElementById('resolution');
  if (!codecSelect || !resSelect) return;

  const selectedCodec = codecSelect.value;
  const res2kOption = resSelect.querySelector('option[value="2560x1440"]');
  const res4kOption = resSelect.querySelector('option[value="3840x2160"]');

  if (selectedCodec === 'H264') {
    if (res2kOption) res2kOption.disabled = true;
    if (res4kOption) res4kOption.disabled = true;

    if (resSelect.value === '2560x1440' || resSelect.value === '3840x2160') {
      resSelect.value = '1920x1080';
      log('[GUARDRAIL] H.264 supports up to 1080p on RK3399 hardware decoder; adjusted to 1080p');
    }
  } else {
    if (res2kOption) res2kOption.disabled = false;
    if (res4kOption) res4kOption.disabled = false;
  }
}

function onResolutionChange() {
  const resSelect = document.getElementById('resolution');
  if (!resSelect) return;
  const resStr = resSelect.value;
  const [w] = resStr.split('x').map(n => parseInt(n, 10));
  const codecSelect = document.getElementById('codec');
  if (codecSelect) {
    if (w >= 2560) {
      codecSelect.value = 'H265';
    }
  }
  updateCodecAndResolutionGuardrails();
}

function onCodecChange() {
  updateCodecAndResolutionGuardrails();
}

function calculateTargetBitrate(bitrateSetting, codec, width, fps) {
  if (bitrateSetting && bitrateSetting !== 'auto') {
    const mbps = parseFloat(bitrateSetting);
    if (!isNaN(mbps) && mbps > 0) {
      return Math.round(mbps * 1_000_000);
    }
  }

  if (codec === 'H265') {
    if (width >= 3840) return fps >= 60 ? 25_000_000 : 15_000_000;
    if (width >= 2560) return fps >= 60 ? 14_000_000 : 9_000_000;
    if (width >= 1920) return fps >= 60 ? 10_000_000 : 6_000_000;
    return fps >= 60 ? 5_000_000 : 3_000_000;
  } else {
    if (width >= 1920) return fps >= 60 ? 16_000_000 : 10_000_000;
    return fps >= 60 ? 8_000_000 : 5_000_000;
  }
}

function getCodecString(codec, width, fps) {
  if (codec === 'H265') {
    return 'hev1.1.6.L150.B0';
  } else {
    if (width >= 3840) {
      return 'avc1.42e033';
    } else if (width >= 2560) {
      return 'avc1.42e032';
    }
    return 'avc1.42e028';
  }
}

async function toggleScreenShare() {
  if (isRemoteStreaming) return;
  if (isStreaming) {
    await stopStreaming();
    return;
  }

  seqNum = 0;

  // Lock settings fields immediately when screen sharing is triggered
  setSettingsDisabled(true);

  const boardIp = window.location.hostname || '192.168.1.72';
  const boardPort = 4433;
  const resStr = document.getElementById('resolution').value;
  const targetFps = parseInt(document.getElementById('fps').value, 10);
  const selectedCodec = document.getElementById('codec').value;
  const bitrateSelect = document.getElementById('bitrate');
  const bitrateSetting = bitrateSelect ? bitrateSelect.value : 'auto';

  const [width, height] = resStr.split('x').map(n => parseInt(n, 10));
  const targetBitrate = calculateTargetBitrate(bitrateSetting, selectedCodec, width, targetFps);
  const targetMbps = (targetBitrate / 1_000_000).toFixed(1);

  // Update telemetry UI
  const statRes = document.getElementById('statResolution');
  const statCodec = document.getElementById('statCodec');
  const statBitrate = document.getElementById('statBitrate');
  if (statRes) statRes.textContent = `${resStr} @ ${targetFps} FPS`;
  if (statCodec) statCodec.textContent = selectedCodec === 'H265' ? 'HEVC / H.265' : 'H.264';
  if (statBitrate) statBitrate.textContent = `${targetMbps} Mbps (${bitrateSetting === 'auto' ? 'Auto' : 'Custom'})`;

  log(`[CONFIG] Codec: ${selectedCodec} | Res: ${resStr} @ ${targetFps} FPS | Bandwidth Cap: ${targetMbps} Mbps`);
  log(`[CONNECTING] WebTransport -> https://${boardIp}:${boardPort}`);
  updateStatus('connecting', 'CONNECTING');

  try {
    const transportOpts = {};
    if (!autoCertHash) {
      try {
        const res = await fetch('/cert_hash');
        if (res.ok) autoCertHash = (await res.text()).trim();
      } catch (e) {}
    }
    const certBytes = parseCertHash(autoCertHash);
    if (certBytes) {
      transportOpts.serverCertificateHashes = [{
        algorithm: 'sha-256',
        value: certBytes.buffer
      }];
      log(`[CERT] Auto-authenticated device TLS SHA-256 fingerprint`);
    }

    transport = new WebTransport(`https://${boardIp}:${boardPort}`, transportOpts);
    await transport.ready;
    writer = transport.datagrams.writable.getWriter();
    log(`[WEBTRANSPORT CONNECTED] Session established over QUIC/UDP!`);

    if (controlWs && controlWs.readyState === WebSocket.OPEN) {
      try {
        controlWs.send(JSON.stringify({
          type: 'start',
          codec: selectedCodec,
          resolution: resStr,
          fps: targetFps,
          bitrate_mbps: parseFloat(targetMbps)
        }));
      } catch (e) {}
    }

    const videoSource = document.getElementById('videoSource').value;
    if (videoSource === 'synthetic') {
      log(`[SOURCE] Using Bouncing Orb / Test Pattern (${width}x${height} @ ${targetFps} FPS)`);
      mediaStream = createSyntheticScreenStream(width, height, targetFps);
    } else {
      log(`[SOURCE] Requesting Chrome Screen Capture (${width}x${height} @ ${targetFps} FPS)...`);
      try {
        mediaStream = await navigator.mediaDevices.getDisplayMedia({
          video: {
            width: { ideal: width },
            height: { ideal: height },
            frameRate: { ideal: targetFps }
          },
          audio: false
        });
        log(`[SOURCE] Native Screen Capture granted!`);
      } catch (captureErr) {
        log(`[SOURCE] Screen capture cancelled or failed: ${captureErr.message}`, true);
        await stopStreaming();
        return;
      }
    }

    const videoTrack = mediaStream.getVideoTracks()[0];
    videoTrack.onended = () => {
      log('[SCREEN CAPTURE] User stopped screen sharing.');
      stopStreaming();
    };

    const trackSettings = videoTrack.getSettings();
    const rawWidth = (videoSource === 'synthetic') ? width : (trackSettings.width || width);
    const rawHeight = (videoSource === 'synthetic') ? height : (trackSettings.height || height);
    const activeWidth = (rawWidth % 16 !== 0) ? Math.ceil(rawWidth / 16) * 16 : rawWidth;
    const activeHeight = (rawHeight % 16 !== 0) ? Math.ceil(rawHeight / 16) * 16 : rawHeight;

    const codecString = getCodecString(selectedCodec, activeWidth, targetFps);
    log(`[WEBCODECS] Initializing ${selectedCodec} Hardware Encoder (${codecString}) at ${activeWidth}x${activeHeight}...`);

    let forceNextKeyframe = false;

    videoEncoder = new VideoEncoder({
      output: async (chunk, metadata) => {
        seqNum++;
        const accessUnit = convertToAnnexB(chunk, metadata, selectedCodec);
        await sendAccessUnit(accessUnit, seqNum, activeWidth, activeHeight, selectedCodec);

        const frameStat = document.getElementById('statFrameCount');
        if (frameStat) frameStat.textContent = seqNum.toString();

        if (seqNum % targetFps === 0) {
          log(`[STREAMING ${selectedCodec}] Frame #${seqNum}: ${activeWidth}x${activeHeight} (${Math.round(accessUnit.length / 1024)} KB) via QUIC stream`);
        }
      },
      error: (e) => {
        log(`[WEBCODECS ERROR] ${e.message}`, true);
        stopStreaming();
      }
    });

    videoEncoder.configure({
      codec: codecString,
      width: activeWidth,
      height: activeHeight,
      bitrate: targetBitrate,
      framerate: targetFps,
      latencyMode: 'realtime',
      hardwareAcceleration: 'prefer-hardware'
    });

    isStreaming = true;
    updateStatus('active', 'STREAMING');

    const toggleBtn = document.getElementById('toggleBtn');
    const toggleText = document.getElementById('toggleText');
    if (toggleBtn && toggleText) {
      toggleText.textContent = 'Stop Screen Sharing';
      toggleBtn.className = 'btn-primary stop';
    }

    const keepAliveTimer = setInterval(() => {
      if (!isStreaming) {
        clearInterval(keepAliveTimer);
        return;
      }
      if (controlWs && controlWs.readyState === WebSocket.OPEN) {
        try { controlWs.send(JSON.stringify({ type: 'ping' })); } catch(e) {}
      }
      if (transport && transport.datagrams && transport.datagrams.writable) {
        try {
          const pingWriter = transport.datagrams.writable.getWriter();
          pingWriter.write(new Uint8Array([80, 73, 78, 71]));
          pingWriter.releaseLock();
        } catch(e) {}
      }
    }, 1000);

    const processor = new MediaStreamTrackProcessor({ track: videoTrack });
    const reader = processor.readable.getReader();

    let frameCount = 0;
    let lastFrameTime = 0;
    const minFrameIntervalMs = 1000 / targetFps - 2;

    while (isStreaming) {
      const { done, value: rawFrame } = await reader.read();
      if (done || !isStreaming) {
        if (rawFrame) rawFrame.close();
        break;
      }

      const now = performance.now();
      if (lastFrameTime > 0 && (now - lastFrameTime) < minFrameIntervalMs) {
        rawFrame.close();
        continue;
      }
      lastFrameTime = now;

      frameCount++;
      const keyframeInterval = Math.max(10, Math.floor(targetFps / 2));
      const needKeyFrame = (frameCount <= 5 || frameCount % keyframeInterval === 0 || forceNextKeyframe);
      if (forceNextKeyframe) forceNextKeyframe = false;

      if (videoEncoder.encodeQueueSize > 8) {
        rawFrame.close();
      } else {
        videoEncoder.encode(rawFrame, { keyFrame: needKeyFrame });
        rawFrame.close();
      }
    }

    clearInterval(keepAliveTimer);

  } catch (err) {
    log(`[ERROR] ${err.message}`, true);
    await stopStreaming();
  }
}

async function stopStreaming() {
  if (!isStreaming && !mediaStream && !transport) {
    setSettingsDisabled(false);
    return;
  }
  isStreaming = false;
  seqNum = 0;
  if (controlWs && controlWs.readyState === WebSocket.OPEN) {
    try {
      controlWs.send(JSON.stringify({ type: 'stop' }));
      log('[CONTROL SOCKET] Sent STOP command to device over independent socket.');
    } catch (e) {}
  }
  if (uniStreamWriter) {
    try {
      const stopPacket = new Uint8Array(20);
      const view = new DataView(stopPacket.buffer);
      view.setUint32(0, 16, false);
      stopPacket[4] = 83;
      stopPacket[5] = 84;
      stopPacket[6] = 79;
      stopPacket[7] = 80;
      await uniStreamWriter.write(stopPacket);
    } catch (e) {}
  }
  if (videoEncoder) {
    try { videoEncoder.close(); } catch (e) {}
    videoEncoder = null;
  }
  if (mediaStream) {
    try { mediaStream.getTracks().forEach(t => t.stop()); } catch (e) {}
    mediaStream = null;
  }
  if (writer) {
    try { writer.releaseLock(); } catch (e) {}
    writer = null;
  }
  if (uniStreamWriter) {
    try { uniStreamWriter.releaseLock(); } catch (e) {}
    uniStreamWriter = null;
  }
  if (transport) {
    try { transport.close(); } catch (e) {}
    transport = null;
  }

  if (!isRemoteStreaming) {
    if (controlWs && controlWs.readyState === WebSocket.OPEN) {
      updateStatus('connected', 'CONNECTED');
    } else {
      updateStatus('disconnected', 'DISCONNECTED');
    }

    const toggleBtn = document.getElementById('toggleBtn');
    const toggleText = document.getElementById('toggleText');
    if (toggleBtn && toggleText) {
      toggleText.textContent = 'Start Screen Sharing';
      toggleBtn.className = 'btn-primary';
      toggleBtn.disabled = false;
    }

    // Re-enable settings fields when screen sharing stops
    setSettingsDisabled(false);
  }

  log('[STOPPED] Screen sharing session closed.');
}

function handleServerStatusUpdate(msg) {
  if (!msg || !msg.state) return;

  const toggleBtn = document.getElementById('toggleBtn');
  const toggleText = document.getElementById('toggleText');

  if (msg.display_resolution) {
    const statDisplay = document.getElementById('statDisplay');
    if (statDisplay) {
      const fpsStr = msg.display_fps ? ` @ ${msg.display_fps} FPS` : '';
      statDisplay.textContent = `${msg.display_resolution}${fpsStr}`;
    }
  }

  if (msg.bitrate_mbps && msg.bitrate_mbps > 0) {
    const statBitrate = document.getElementById('statBitrate');
    if (statBitrate) {
      statBitrate.textContent = `${msg.bitrate_mbps.toFixed(1)} Mbps`;
    }
  }

  if (msg.state === 'STREAMING') {
    if (isStreaming) {
      updateStatus('active', 'STREAMING');
      setSettingsDisabled(true);
      if (toggleBtn && toggleText) {
        toggleText.textContent = 'Stop Screen Sharing';
        toggleBtn.className = 'btn-primary stop';
        toggleBtn.disabled = false;
      }
    } else {
      isRemoteStreaming = true;
      updateStatus('active', 'STREAMING (IN USE)');
      setSettingsDisabled(true);
      if (toggleBtn && toggleText) {
        toggleText.textContent = 'Screen Sharing Active (In Use)';
        toggleBtn.className = 'btn-primary stop';
        toggleBtn.disabled = true;
      }
    }
    if (msg.resolution && msg.resolution !== '0x0') {
      const statRes = document.getElementById('statResolution');
      if (statRes) {
        if (msg.resolution.includes('@')) {
          statRes.textContent = msg.resolution;
        } else {
          const fpsVal = msg.fps || 30;
          statRes.textContent = `${msg.resolution} @ ${fpsVal} FPS`;
        }
      }
    }
  } else if (msg.state === 'IDLE') {
    isRemoteStreaming = false;
    if (!isStreaming) {
      if (controlWs && controlWs.readyState === WebSocket.OPEN) {
        updateStatus('connected', 'CONNECTED');
      } else {
        updateStatus('disconnected', 'DISCONNECTED');
      }
      setSettingsDisabled(false);
      if (toggleBtn && toggleText) {
        toggleText.textContent = 'Start Screen Sharing';
        toggleBtn.className = 'btn-primary';
        toggleBtn.disabled = false;
      }
    } else {
      stopStreaming();
    }
  }
}

function initControlSocket() {
  const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  const host = window.location.host || '192.168.1.72:8080';
  const wsUrl = `${wsProtocol}//${host}/ws`;

  updateStatus('connecting', 'CONNECTING...');

  try {
    controlWs = new WebSocket(wsUrl);
    controlWs.onopen = () => {
      log(`[CONTROL SOCKET] Connected to independent command & telemetry channel (${wsUrl})`);
      updateStatus('connected', 'CONNECTED');
      try {
        controlWs.send(JSON.stringify({ type: 'get_status' }));
      } catch (e) {}
    };
    controlWs.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.type === 'status') {
          log(`[TELEMETRY] Device State: ${msg.state} | Res: ${msg.resolution} | Display: ${msg.display_resolution || 'N/A'} @ ${msg.display_fps || 0}FPS | Frames: ${msg.frames_submitted}`);
          handleServerStatusUpdate(msg);
        } else if (msg.type === 'pong') {
          log(`[CONTROL SOCKET] Received pong from device`);
        }
      } catch (e) {}
    };
    controlWs.onerror = () => {
      updateStatus('disconnected', 'DISCONNECTED');
    };
    controlWs.onclose = () => {
      updateStatus('disconnected', 'DISCONNECTED');
      setTimeout(initControlSocket, 3000);
    };
  } catch (e) {
    updateStatus('disconnected', 'DISCONNECTED');
  }
}

window.addEventListener('DOMContentLoaded', async () => {
  initControlSocket();

  const resSelect = document.getElementById('resolution');
  if (resSelect) {
    resSelect.addEventListener('change', onResolutionChange);
  }

  const codecSelect = document.getElementById('codec');
  if (codecSelect) {
    codecSelect.addEventListener('change', onCodecChange);
  }

  updateCodecAndResolutionGuardrails();

  try {
    const res = await fetch('/cert_hash');
    if (res.ok) {
      autoCertHash = (await res.text()).trim();
      log(`[AUTO-CONFIG] Ready to stream to ${window.location.hostname || 'device'}`);
    }
  } catch (e) {}
});
</script>

