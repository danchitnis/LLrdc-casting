---
import Header from '../components/Header.astro';
import SettingsCard from '../components/SettingsCard.astro';
import TelemetryCard from '../components/TelemetryCard.astro';
import LogConsole from '../components/LogConsole.astro';
import { PAIRING_CONFIG } from '../lib/config';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LLrdc Casting | Ultra Low Latency Hardware Video Streamer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --color-bg: #0b0f17;
      --color-card: #131b2e;
      --color-border: #23304a;
      --color-accent: #38bdf8;
      --color-accent-hover: #0284c7;
      --color-success: #10b981;
      --color-danger: #ef4444;
      --color-danger-hover: #dc2626;
      --color-text: #f1f5f9;
      --color-text-muted: #94a3b8;
      --font-main: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-main);
      background-color: var(--color-bg);
      background-image: 
        radial-gradient(at 0% 0%, rgba(56, 189, 248, 0.07) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(99, 102, 241, 0.07) 0px, transparent 50%);
      background-attachment: fixed;
      color: var(--color-text);
      margin: 0;
      padding: 32px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }

    .main-container {
      width: 100%;
      max-width: 860px;
    }

    .action-container {
      margin-bottom: 24px;
    }

    .pairing-card {
      background: rgba(19, 27, 46, 0.92);
      border: 1px solid var(--color-border);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 24px;
    }

    .pairing-card h2 {
      margin: 0 0 8px;
      font-size: 1.05rem;
    }

    .pairing-card p {
      color: var(--color-text-muted);
      margin: 0 0 16px;
      font-size: 0.9rem;
    }

    .pairing-row {
      display: flex;
      gap: 10px;
    }

    .pairing-row input {
      min-width: 0;
      flex: 1;
      background: #0b1220;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      color: var(--color-text);
      font: 700 1.6rem var(--font-mono);
      letter-spacing: 0.3em;
      padding: 12px 14px;
      text-align: center;
      text-transform: uppercase;
    }

    .pairing-row button {
      border: 0;
      border-radius: 10px;
      padding: 0 20px;
      color: white;
      background: #0ea5e9;
      font-weight: 700;
      cursor: pointer;
    }

    .pairing-row button:disabled {
      opacity: 0.55;
      cursor: wait;
    }

    #pairStatus {
      display: block;
      margin-top: 12px;
      color: var(--color-text-muted);
      font-size: 0.85rem;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    @media (max-width: 520px) {
      .pairing-row {
        flex-direction: column;
      }
      .pairing-row button {
        min-height: 44px;
      }
    }

    .btn-primary {
      width: 100%;
      padding: 16px 24px;
      background: linear-gradient(135deg, #0284c7, #2563eb);
      color: #ffffff;
      border: 1px solid rgba(56, 189, 248, 0.4);
      border-radius: 12px;
      font-size: 1.05rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-primary:hover:not(:disabled) {
      background: linear-gradient(135deg, #0369a1, #1d4ed8);
      box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
      transform: translateY(-1px);
    }

    .btn-primary:active:not(:disabled) {
      transform: translateY(1px);
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }

    .btn-primary.stop {
      background: linear-gradient(135deg, #dc2626, #b91c1c);
      border-color: rgba(239, 68, 68, 0.4);
      box-shadow: 0 4px 16px rgba(220, 38, 38, 0.35);
    }

    .btn-primary.stop:hover:not(:disabled) {
      background: linear-gradient(135deg, #b91c1c, #991b1b);
      box-shadow: 0 6px 20px rgba(220, 38, 38, 0.5);
    }

    .btn-primary.stop:disabled {
      background: linear-gradient(135deg, #7f1d1d, #991b1b);
      border-color: rgba(239, 68, 68, 0.4);
      color: #fca5a5;
      cursor: not-allowed;
      box-shadow: 0 4px 16px rgba(220, 38, 38, 0.2);
      opacity: 0.85;
    }

    .btn-primary:disabled {
      background: #1e293b;
      border-color: #334155;
      color: #64748b;
      cursor: not-allowed;
      box-shadow: none;
      transform: none;
    }
  </style>
</head>
<body>

<div class="main-container">
  <Header />

  <section class="pairing-card" aria-labelledby="pairingTitle">
    <h2 id="pairingTitle">Connect to a receiver</h2>
    <p>Enter the {PAIRING_CONFIG.CODE_LENGTH}-character code shown on the receiver's HDMI screen. Video stays on the local network.</p>
    <form id="pairForm">
      <div class="pairing-row">
        <input id="pairCode" name="code" inputmode="text" pattern={PAIRING_CONFIG.CODE_PATTERN.source} maxlength={PAIRING_CONFIG.CODE_LENGTH} autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" placeholder="A78Q" aria-label={`${PAIRING_CONFIG.CODE_LENGTH}-character receiver code`} required />
        <button id="pairBtn" type="submit">Connect</button>
      </div>
    </form>
    <span id="pairStatus" role="status">Waiting for code</span>
  </section>

  <SettingsCard />

  <div class="action-container">
    <button id="toggleBtn" class="btn-primary" onclick="toggleCasting()">
      <svg id="toggleIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
      </svg>
      <span id="toggleText">Start Casting</span>
    </button>
  </div>

  <TelemetryCard />

  <LogConsole />
</div>

<script>
  import { toggleCasting, initPairing, pairWithCode, log } from '../lib/streamer';
  import { onResolutionChange, onCodecChange, checkBrowserCodecCapabilities } from '../lib/guardrails';

  declare global {
    interface Window {
      toggleCasting: typeof toggleCasting;
    }
  }

  // Expose toggleCasting globally for HTML button onclick
  window.toggleCasting = toggleCasting;

  window.addEventListener('DOMContentLoaded', async () => {
    initPairing();

    const pairForm = document.getElementById('pairForm') as HTMLFormElement | null;
    const pairCode = document.getElementById('pairCode') as HTMLInputElement | null;
    const pairBtn = document.getElementById('pairBtn') as HTMLButtonElement | null;
    const pairStatus = document.getElementById('pairStatus');
    pairCode?.addEventListener('input', () => {
      pairCode.value = pairCode.value.toUpperCase();
    });
    pairForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!pairCode || !pairBtn) return;
      pairBtn.disabled = true;
      if (pairStatus) pairStatus.textContent = 'PAIRING';
      try {
        await pairWithCode(pairCode.value);
        if (pairStatus) pairStatus.textContent = 'PAIRED';
      } catch (error) {
        if (pairStatus) pairStatus.textContent = 'PAIR FAILED';
        log(`[PAIRING] ${(error as Error).message}`, true);
      } finally {
        pairBtn.disabled = false;
      }
    });

    const resSelect = document.getElementById('resolution') as HTMLSelectElement | null;
    if (resSelect) {
      resSelect.addEventListener('change', () => onResolutionChange(log));
    }

    const codecSelect = document.getElementById('codec') as HTMLSelectElement | null;
    if (codecSelect) {
      codecSelect.addEventListener('change', () => onCodecChange(log));
    }

    await checkBrowserCodecCapabilities(log);

    log('[PAIRING] Enter the HDMI code.');
    const bootstrapConnection = window.__LLRDC_BOOTSTRAP_CONNECTION__;
    if (bootstrapConnection) {
      if (pairCode) pairCode.value = bootstrapConnection.code;
      try {
        await pairWithCode(bootstrapConnection.code);
      } catch {
        if (pairStatus) pairStatus.textContent = 'PAIR FAILED';
      }
    }
  });
</script>

</body>
</html>
